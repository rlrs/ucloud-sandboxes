 // Resume sends the resume call for a container in the sandbox.
 func (s *Sandbox) Resume(cid string) error {
 	log.Debugf("Resume sandbox %q", s.ID)
+	if s.HibernatedMemoryFilePath != "" {
+		if err := os.Rename(s.HibernatedMemoryFilePath, s.ApplicationMemoryFilePath); err != nil {
+			return fmt.Errorf("moving captured application memory back into active storage: %w", err)
+		}
+	}
 	if err := s.call(boot.ContMgrResume, nil, nil); err != nil {
+		if s.HibernatedMemoryFilePath != "" {
+			if renameErr := os.Rename(s.ApplicationMemoryFilePath, s.HibernatedMemoryFilePath); renameErr != nil {
+				return fmt.Errorf("resuming container %q: %w (also failed to return application memory to checkpoint: %v)", cid, err, renameErr)
+			}
+		}
 		return fmt.Errorf("resuming container %q: %w", cid, err)
 	}
+	s.HibernatedMemoryFilePath = ""
+	s.Checkpointed = false
 	return nil
 }
 
