diff --git a/runsc/container/container.go b/runsc/container/container.go
index f0bfbf2..12bd09c 100644
--- a/runsc/container/container.go
+++ b/runsc/container/container.go
@@ -825,6 +825,32 @@ func (c *Container) ForwardSignals(pid int32, fgProcess bool) func() {
 // The statefile will be written to f, the file at the specified image-path.
 func (c *Container) Checkpoint(conf *config.Config, imagePath string, opts sandbox.CheckpointOpts) error {
 	log.Debugf("Checkpoint container, cid: %s", c.ID)
+	if opts.Hibernate {
+		if err := c.Saver.lock(BlockAcquire); err != nil {
+			return err
+		}
+		defer c.Saver.UnlockOrDie()
+
+		if c.Status != Running {
+			return fmt.Errorf("cannot hibernate container %q in state %v", c.ID, c.Status)
+		}
+		if err := c.Sandbox.Checkpoint(conf, c.ID, imagePath, opts); err != nil {
+			return err
+		}
+		c.changeStatus(Paused)
+		if err := c.saveLocked(); err != nil {
+			// A capture is not committed until its paused state is durable.
+			// Roll it back while the sentry is still available.
+			resumeErr := c.Sandbox.Resume(c.ID)
+			c.changeStatus(Running)
+			rollbackSaveErr := c.saveLocked()
+			if resumeErr != nil || rollbackSaveErr != nil {
+				return fmt.Errorf("saving hibernated container metadata: %w (rollback resume: %v; rollback metadata save: %v)", err, resumeErr, rollbackSaveErr)
+			}
+			return fmt.Errorf("saving hibernated container metadata: %w", err)
+		}
+		return nil
+	}
 	if err := c.requireStatus("checkpoint", Created, Running, Paused); err != nil {
 		return err
 	}
