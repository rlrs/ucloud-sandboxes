@@ -209,3 +231,25 @@ func (r *Restore) Execute(_ context.Context, f *flag.FlagSet, args ...any) subco
 
 	return subcommands.ExitSuccess
 }
+
+// removeCPUQuotaForStartup replaces spec's resources with a shallow copy whose
+// CPU quota is explicitly unlimited and whose burst is absent. An explicit -1
+// is required to reset a reused cgroup that still has the prior incarnation's
+// quota. It returns the exact original resources so Container.Update can
+// durably reapply them before restore succeeds.
+func removeCPUQuotaForStartup(spec *specs.Spec) *specs.LinuxResources {
+	if spec.Linux == nil || spec.Linux.Resources == nil ||
+		spec.Linux.Resources.CPU == nil ||
+		spec.Linux.Resources.CPU.Quota == nil {
+		return nil
+	}
+	steadyState := spec.Linux.Resources
+	startupResources := *steadyState
+	startupCPU := *steadyState.CPU
+	unlimitedQuota := int64(-1)
+	startupCPU.Quota = &unlimitedQuota
+	startupCPU.Burst = nil
+	startupResources.CPU = &startupCPU
+	spec.Linux.Resources = &startupResources
+	return steadyState
+}
