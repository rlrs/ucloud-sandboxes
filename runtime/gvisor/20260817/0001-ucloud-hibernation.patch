+// destroyAndWait models process teardown: hibernation stops the sentry without
+// freeing the allocations whose metadata was just checkpointed.
+func destroyAndWait(t *testing.T, mf *MemoryFile) {
+	t.Helper()
+	mf.Destroy()
+	deadline := time.Now().Add(5 * time.Second)
+	for {
+		mf.mu.Lock()
+		destroyed := mf.file == nil
+		mf.mu.Unlock()
+		if destroyed {
+			return
+		}
+		if time.Now().After(deadline) {
+			t.Fatal("timed out waiting for MemoryFile destruction")
+		}
+		time.Sleep(time.Millisecond)
+	}
+}
+
+func TestExternalBackingSaveRestore(t *testing.T) {
+	backingPath := t.TempDir() + "/memory"
+	backing, err := os.OpenFile(backingPath, os.O_CREATE|os.O_EXCL|os.O_RDWR, 0600)
+	if err != nil {
+		t.Fatalf("OpenFile: %v", err)
+	}
+	mf, err := NewMemoryFile(backing, MemoryFileOpts{
+		DiskBackedFile: true,
+	})
+	if err != nil {
+		t.Fatalf("NewMemoryFile: %v", err)
+	}
+
+	fr, err := mf.Allocate(3*hostarch.PageSize, AllocOpts{
+		Mode: AllocateAndCommit,
+	})
+	if err != nil {
+		t.Fatalf("Allocate: %v", err)
+	}
+	mapped, err := mf.MapInternal(fr, hostarch.ReadWrite)
+	if err != nil {
+		t.Fatalf("MapInternal: %v", err)
+	}
+	want := bytes.Repeat([]byte{0xa5}, int(fr.Length()))
+	copy(mapped.Head().ToSlice(), want)
+
+	var metadata bytes.Buffer
+	if err := mf.SaveTo(context.Background(), &metadata, &SaveOpts{
+		ExternalBacking: true,
+	}); err != nil {
+		t.Fatalf("SaveTo: %v", err)
+	}
+	if got := metadata.Len(); got >= len(want) {
+		t.Fatalf("metadata-only checkpoint is %d bytes, want less than %d bytes of page contents", got, len(want))
+	}
+	destroyAndWait(t, mf)
+
+	restoredBacking, err := os.OpenFile(backingPath, os.O_RDWR, 0)
+	if err != nil {
+		t.Fatalf("reopening backing file: %v", err)
+	}
+	restored, err := NewMemoryFile(restoredBacking, MemoryFileOpts{
+		DiskBackedFile:   true,
+		PreserveContents: true,
+	})
+	if err != nil {
+		t.Fatalf("NewMemoryFile(preserve): %v", err)
+	}
+	if err := restored.LoadFrom(context.Background(), &metadata, &LoadOpts{
+		ExternalBacking: true,
+	}); err != nil {
+		t.Fatalf("LoadFrom: %v", err)
+	}
+	gotMapped, err := restored.MapInternal(fr, hostarch.Read)
+	if err != nil {
+		t.Fatalf("restored MapInternal: %v", err)
+	}
+	if got := gotMapped.Head().ToSlice(); !bytes.Equal(got, want) {
+		t.Fatalf("restored contents differ: got first bytes %x, want %x", got[:16], want[:16])
+	}
+	destroyAndWait(t, restored)
+}
+
+func TestExternalBackingRestoreRejectsWrongSize(t *testing.T) {
+	backingPath := t.TempDir() + "/memory"
+	backing, err := os.OpenFile(backingPath, os.O_CREATE|os.O_EXCL|os.O_RDWR, 0600)
+	if err != nil {
+		t.Fatalf("OpenFile: %v", err)
+	}
+	mf, err := NewMemoryFile(backing, MemoryFileOpts{DiskBackedFile: true})
+	if err != nil {
+		t.Fatalf("NewMemoryFile: %v", err)
+	}
+	if _, err := mf.Allocate(hostarch.PageSize, AllocOpts{Mode: AllocateAndCommit}); err != nil {
+		t.Fatalf("Allocate: %v", err)
+	}
+	var metadata bytes.Buffer
+	if err := mf.SaveTo(context.Background(), &metadata, &SaveOpts{ExternalBacking: true}); err != nil {
+		t.Fatalf("SaveTo: %v", err)
+	}
+	destroyAndWait(t, mf)
+
+	if err := os.Truncate(backingPath, chunkSize-hostarch.PageSize); err != nil {
+		t.Fatalf("Truncate: %v", err)
+	}
+	restoredBacking, err := os.OpenFile(backingPath, os.O_RDWR, 0)
+	if err != nil {
+		t.Fatalf("reopening backing file: %v", err)
+	}
+	restored, err := NewMemoryFile(restoredBacking, MemoryFileOpts{
+		DiskBackedFile:   true,
+		PreserveContents: true,
+	})
+	if err != nil {
+		t.Fatalf("NewMemoryFile(preserve): %v", err)
+	}
+	if err := restored.LoadFrom(context.Background(), &metadata, &LoadOpts{ExternalBacking: true}); err == nil {
+		t.Fatalf("LoadFrom succeeded with wrong backing-file size")
+	}
+	destroyAndWait(t, restored)
+}
