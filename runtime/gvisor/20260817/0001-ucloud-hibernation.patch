+
+package cmd
+
+import (
+	"testing"
+
+	specs "github.com/opencontainers/runtime-spec/specs-go"
+)
+
+func TestRemoveCPUQuotaForStartup(t *testing.T) {
+	quota := int64(25000)
+	period := uint64(100000)
+	burst := uint64(5000)
+	memory := int64(128 << 20)
+	steadyState := &specs.LinuxResources{
+		CPU: &specs.LinuxCPU{
+			Quota:  &quota,
+			Period: &period,
+			Burst:  &burst,
+		},
+		Memory: &specs.LinuxMemory{Limit: &memory},
+	}
+	spec := &specs.Spec{
+		Linux: &specs.Linux{Resources: steadyState},
+	}
+
+	got := removeCPUQuotaForStartup(spec)
+	if got != steadyState {
+		t.Fatalf("removeCPUQuotaForStartup() returned %p, want %p", got, steadyState)
+	}
+	if spec.Linux.Resources == steadyState {
+		t.Fatal("startup resources alias steady-state resources")
+	}
+	if spec.Linux.Resources.CPU == steadyState.CPU {
+		t.Fatal("startup CPU resources alias steady-state CPU resources")
+	}
+	if got, want := *spec.Linux.Resources.CPU.Quota, int64(-1); got != want {
+		t.Fatalf("startup CPU quota = %v, want %v", got, want)
+	}
+	if spec.Linux.Resources.CPU.Burst != nil {
+		t.Fatalf("startup CPU burst = %v, want nil", *spec.Linux.Resources.CPU.Burst)
+	}
+	if spec.Linux.Resources.CPU.Period != &period {
+		t.Fatal("startup CPU period changed")
+	}
+	if spec.Linux.Resources.Memory != steadyState.Memory {
+		t.Fatal("non-CPU resources changed")
+	}
+	if steadyState.CPU.Quota != &quota || steadyState.CPU.Burst != &burst {
+		t.Fatal("steady-state CPU resources were mutated")
+	}
+}
