+// terminateForHibernation stops a quiesced sentry without giving guest-memory
+// teardown an opportunity to mutate its canonical backing file.
+func (s *Sandbox) terminateForHibernation() error {
+	pid := s.Pid.Load()
+	if pid == 0 {
+		return nil
+	}
+	pidfd, pidfdErr := unix.PidfdOpen(int(pid), 0)
+	if pidfdErr == nil {
+		defer unix.Close(pidfd)
+	}
+	if err := unix.Kill(pid, unix.SIGKILL); err != nil && err != unix.ESRCH {
+		return fmt.Errorf("terminating hibernated sandbox %q PID %d: %w", s.ID, pid, err)
+	}
+	if pidfdErr != nil {
+		if err := s.waitForStopped(); err != nil {
+			return fmt.Errorf("waiting for hibernated sandbox %q to stop: %w", s.ID, err)
+		}
+		return nil
+	}
+	for {
+		events := []unix.PollFd{{Fd: int32(pidfd), Events: unix.POLLIN}}
+		n, err := unix.Poll(events, int((2 * time.Minute).Milliseconds()))
+		if err == unix.EINTR {
+			continue
+		}
+		if err != nil {
+			return fmt.Errorf("waiting on pidfd for hibernated sandbox %q: %w", s.ID, err)
+		}
+		if n == 0 {
+			return fmt.Errorf("timed out waiting for hibernated sandbox %q to stop", s.ID)
+		}
+		break
+	}
+	if s.child {
+		if err := s.waitForStopped(); err != nil {
+			return fmt.Errorf("reaping hibernated sandbox %q: %w", s.ID, err)
+		}
+	} else {
+		s.Pid.Store(0)
+	}
+	return nil
+}
