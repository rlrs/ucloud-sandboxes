 }
+
+// TestCreateUmaskAndDefaultACL verifies that the original requested mode, not
+// the mode after umask, bounds inherited ACLs. The named user is not in the
+// owning group, so successful writes require actual ACL enforcement.
+func TestCreateUmaskAndDefaultACL(t *testing.T) {
+	for _, hasACL := range []bool{false, true} {
+		for _, umask := range []linux.FileMode{0022, 0077} {
+			for _, kind := range []string{"file", "directory", "fifo"} {
+				for _, private := range []bool{false, true} {
+					t.Run(fmt.Sprintf("acl=%v/umask=%03o/%s/private=%v", hasACL, umask, kind, private), func(t *testing.T) {
+						ctx := contexttest.Context(t)
+						creds := auth.CredentialsFromContext(ctx)
+						vfsObj, root, cleanup, err := newTmpfsRoot(ctx)
+						if err != nil {
+							t.Fatal(err)
+						}
+						defer cleanup()
+						rootPop := vfs.PathOperation{Root: root, Start: root}
+						if hasACL {
+							mask := vfs.MayRead | vfs.MayWrite | vfs.MayExec
+							acl := &vfs.PosixACL{UGOPerms: 0700, Mask: &mask, Users: []vfs.ACLUser{{UID: 1001, Perms: mask}}}
+							if _, _, err := vfsObj.SetPosixACLAt(ctx, creds, &rootPop, vfs.DefaultACL, acl, false); err != nil {
+								t.Fatal(err)
+							}
+						}
+						mode := linux.FileMode(0666)
+						if kind == "directory" {
+							mode = 0777
+						}
+						if private {
+							mode &= 0700
+						}
+						pop := vfs.PathOperation{Root: root, Start: root, Path: fspath.Parse("child")}
+						switch kind {
+						case "file":
+							fd, err := vfsObj.OpenAt(ctx, creds, &pop, &vfs.OpenOptions{Flags: linux.O_CREAT | linux.O_EXCL | linux.O_RDWR, Mode: mode, Umask: umask})
+							if err != nil {
+								t.Fatal(err)
+							}
+							fd.DecRef(ctx)
+						case "directory":
+							if err := vfsObj.MkdirAt(ctx, creds, &pop, &vfs.MkdirOptions{Mode: mode, Umask: umask}); err != nil {
+								t.Fatal(err)
+							}
+						case "fifo":
+							if err := vfsObj.MknodAt(ctx, creds, &pop, &vfs.MknodOptions{Mode: linux.S_IFIFO | mode, Umask: umask}); err != nil {
+								t.Fatal(err)
+							}
+						}
+						stat, err := vfsObj.StatAt(ctx, creds, &pop, &vfs.StatOptions{Mask: linux.STATX_MODE})
+						if err != nil {
+							t.Fatal(err)
+						}
+						want := mode &^ umask
+						if hasACL {
+							want = mode & 0770
+						}
+						if got := linux.FileMode(stat.Mode) & 0777; got != want {
+							t.Errorf("mode=%#o, want %#o", got, want)
+						}
+						other := auth.NewUserCredentials(1001, 1001, nil, &auth.TaskCapabilities{}, creds.UserNamespace)
+						err = vfsObj.AccessAt(ctx, other, vfs.MayWrite, &pop)
+						if hasACL && !private {
+							if err != nil {
+								t.Errorf("named user write denied: %v", err)
+							}
+						} else if !linuxerr.Equals(linuxerr.EACCES, err) {
+							t.Errorf("private/umasked write error=%v, want EACCES", err)
+						}
+					})
+				}
+			}
+		}
+	}
+}
