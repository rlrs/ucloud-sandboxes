--- /dev/null
+++ b/runsc/sandbox/boot_executable_test.go
@@ -0,0 +1,56 @@
+package sandbox
+
+import (
+	"os"
+	"os/exec"
+	"path/filepath"
+	"strings"
+	"testing"
+)
+
+func TestPinnedBootExecutable(t *testing.T) {
+	for _, wrapped := range []bool{false, true} {
+		t.Run(map[bool]string{false: "direct", true: "prewarmer-shaped"}[wrapped], func(t *testing.T) {
+			executable := "/bin/echo"
+			cmd := exec.Command(executable, "host-fd-execution")
+			if wrapped {
+				// Match the prewarmer's separate executable path and argv[0].
+				wrapper := filepath.Join(t.TempDir(), "prewarmer")
+				if err := os.WriteFile(wrapper, []byte("#!/bin/bash\nexec -a \"$2\" \"$1\" \"${@:3}\"\n"), 0700); err != nil {
+					t.Fatal(err)
+				}
+				cmd = exec.Command(wrapper, executable, executable, "host-fd-execution")
+			}
+			// A prior donation must not be overwritten or change the child's FD index.
+			prior, err := os.Open("/dev/null")
+			if err != nil {
+				t.Fatal(err)
+			}
+			defer prior.Close()
+			cmd.ExtraFiles = append(cmd.ExtraFiles, prior)
+			file, fd, err := pinBootExecutable(cmd, executable)
+			if err != nil {
+				t.Fatal(err)
+			}
+			defer file.Close()
+			if fd != 4 || len(cmd.ExtraFiles) != 2 {
+				t.Fatalf("fd=%d files=%d", fd, len(cmd.ExtraFiles))
+			}
+			output, err := cmd.CombinedOutput()
+			if err != nil {
+				t.Fatalf("exec: %v: %s", err, output)
+			}
+			if strings.TrimSpace(string(output)) != "host-fd-execution" {
+				t.Fatalf("output=%q", output)
+			}
+		})
+	}
+}
+
+func TestPinnedBootExecutableRejectsUnexpectedWrapper(t *testing.T) {
+	cmd := exec.Command("/bin/echo", "unexpected")
+	file, fd, err := pinBootExecutable(cmd, "/usr/bin/env")
+	if err == nil || file != nil || fd != -1 || len(cmd.ExtraFiles) != 0 {
+		t.Fatalf("file=%v fd=%d err=%v", file, fd, err)
+	}
+}
