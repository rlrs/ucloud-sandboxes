+
+// pinBootExecutable keeps direct and prewarmed launches on the host's original
+// executable mount. The returned file must remain open until cmd.Start.
+func pinBootExecutable(cmd *exec.Cmd, executable string) (*os.File, int, error) {
+	file, err := os.Open(executable)
+	if err != nil {
+		return nil, -1, err
+	}
+	fd := 3 + len(cmd.ExtraFiles)
+	target := fmt.Sprintf("/proc/self/fd/%d", fd)
+	if cmd.Path == executable {
+		cmd.Path = target
+	} else {
+		// The prewarmer's first argument is the executable it will exec.
+		if len(cmd.Args) < 2 || cmd.Args[1] != executable {
+			file.Close()
+			return nil, -1, fmt.Errorf("unexpected boot command wrapper")
+		}
+		cmd.Args[1] = target
+	}
+	cmd.ExtraFiles = append(cmd.ExtraFiles, file)
+	return file, fd, nil
+}
