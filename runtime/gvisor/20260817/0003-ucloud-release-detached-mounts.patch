+
+func TestWithoutCgroupCPUWatcher(t *testing.T) {
+	original := []string{"KEEP=value", "GODEBUG=asyncpreemptoff=1,containermaxprocs=1", "GODEBUG=cgocheck=0,updatemaxprocs=1", "GOMAXPROCS=4"}
+	got := WithoutCgroupCPUWatcher(original)
+	want := []string{"KEEP=value", "GOMAXPROCS=4", "GODEBUG=asyncpreemptoff=1,cgocheck=0,containermaxprocs=0,updatemaxprocs=0"}
+	if len(got) != len(want) {
+		t.Fatalf("got=%v", got)
+	}
+	for i := range want {
+		if got[i] != want[i] {
+			t.Fatalf("got=%v want=%v", got, want)
+		}
+	}
+	if original[1] != "GODEBUG=asyncpreemptoff=1,containermaxprocs=1" {
+		t.Fatal("mutated caller environment")
+	}
+}
