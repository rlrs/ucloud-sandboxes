index 435b456..b4e8541 100644
--- a/runsc/specutils/specutils.go
+++ b/runsc/specutils/specutils.go
@@ -1061,3 +1061,24 @@ func Features() *features.Features {
 
 	return globalFeatures
 }
+
+// WithoutCgroupCPUWatcher prevents Go's lifetime CPU-limit descriptor from
+// pinning a detached clone of the host mount tree after entering a userns.
+// The sentry sets GOMAXPROCS explicitly from its configured CPU count.
+func WithoutCgroupCPUWatcher(env []string) []string {
+	out := make([]string, 0, len(env)+1)
+	var debug []string
+	for _, value := range env {
+		if strings.HasPrefix(value, "GODEBUG=") {
+			for _, option := range strings.Split(strings.TrimPrefix(value, "GODEBUG="), ",") {
+				if option != "" && !strings.HasPrefix(option, "containermaxprocs=") && !strings.HasPrefix(option, "updatemaxprocs=") {
+					debug = append(debug, option)
+				}
+			}
+		} else {
+			out = append(out, value)
+		}
+	}
+	debug = append(debug, "containermaxprocs=0", "updatemaxprocs=0")
+	return append(out, "GODEBUG="+strings.Join(debug, ","))
+}
