 func (k *Kernel) Unpause() {
 	k.extMu.Lock()
 	defer k.extMu.Unlock()
+	if k.externalMemoryCaptured {
+		// SaveTo deliberately left timers stopped and filesystem save hooks
+		// active. Restore both before allowing original guest tasks to run.
+		ctx := k.SupervisorContext()
+		k.BeforeResume(ctx)
+		k.resumeTimeLocked(ctx)
+		k.externalMemoryCaptured = false
+	}
