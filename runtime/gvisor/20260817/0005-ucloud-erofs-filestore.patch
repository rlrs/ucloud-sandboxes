+// TestRootfsEROFSDiskOverlay covers descriptor donation without a gofer and
+// honors the root annotation's directory independently of the global overlay.
+func TestRootfsEROFSDiskOverlay(t *testing.T) {
+	skipIfNotAvailable(t, "mkfs.erofs", "busybox")
+	testDir := t.TempDir()
+	rootfsDir, image, err := createRootfsEROFS(testDir)
+	if err != nil {
+		t.Fatal(err)
+	}
+	for _, withGofer := range []bool{false, true} {
+		t.Run(fmt.Sprintf("withGofer=%v", withGofer), func(t *testing.T) {
+			spec := testutil.NewSpecWithArgs("/busybox", "sh", "-ec", "echo written >/new-file; test \"$(/busybox cat /new-file)\" = written")
+			spec.Root.Path = rootfsDir
+			spec.Root.Readonly = false
+			spec.Annotations = map[string]string{
+				boot.RootfsPrefix + "type": erofs.Name,
+				boot.RootfsPrefix + "source": image,
+				boot.RootfsPrefix + "overlay": "dir=" + t.TempDir(),
+			}
+			spec.Mounts = nil
+			if withGofer {
+				spec.Mounts = []specs.Mount{{Type: "bind", Destination: "/tmp", Source: t.TempDir(), Options: []string{"bind", "rw"}}}
+			}
+			conf := testutil.TestConfig(t)
+			_, bundle, cleanup, err := testutil.SetupContainer(spec, conf)
+			if err != nil {
+				t.Fatal(err)
+			}
+			defer cleanup()
+			ws, err := Run(conf, Args{ID: testutil.RandomContainerID(), Spec: spec, BundleDir: bundle, Attached: true})
+			if err != nil {
+				t.Fatal(err)
+			}
+			if ws.ExitStatus() != 0 {
+				t.Fatalf("exit status = %v, want 0", ws.ExitStatus())
+			}
+		})
+	}
+}
