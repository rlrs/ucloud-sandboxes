new file mode 100644
--- /dev/null
+++ b/runsc/boot/application_memory.go
@@ -0,0 +1,77 @@
+// Copyright 2026 The gVisor Authors.
+// SPDX-License-Identifier: Apache-2.0
+package boot
+
+import (
+	"fmt"
+	"golang.org/x/sys/unix"
+	"io"
+	"os"
+)
+
+// CopySparseApplicationMemory copies the allocated extents of a quiesced memory
+// file. The caller must own an empty destination and hold the source immutable.
+// During restore the caller must execute in the sandbox cgroup so tmpfs pages
+// are charged to the sandbox's memory limit rather than the management process.
+func CopySparseApplicationMemory(dst, src *os.File) error {
+	var source, target unix.Stat_t
+	if err := unix.Fstat(int(src.Fd()), &source); err != nil {
+		return err
+	}
+	if err := unix.Fstat(int(dst.Fd()), &target); err != nil {
+		return err
+	}
+	if source.Mode&unix.S_IFMT != unix.S_IFREG || target.Mode&unix.S_IFMT != unix.S_IFREG || target.Size != 0 || (source.Dev == target.Dev && source.Ino == target.Ino) {
+		return fmt.Errorf("sparse application memory requires a regular source and distinct empty target")
+	}
+	if err := dst.Truncate(source.Size); err != nil {
+		return err
+	}
+	buffer := make([]byte, 256*1024)
+	for cursor := int64(0); cursor < source.Size; {
+		data, err := unix.Seek(int(src.Fd()), cursor, unix.SEEK_DATA)
+		if err == unix.ENXIO {
+			break
+		}
+		if err != nil {
+			return err
+		}
+		hole, err := unix.Seek(int(src.Fd()), data, unix.SEEK_HOLE)
+		if err != nil {
+			return err
+		}
+		if data < cursor || hole <= data || hole > source.Size {
+			return fmt.Errorf("invalid application memory extent")
+		}
+		for offset := data; offset < hole; {
+			size := int64(len(buffer))
+			if hole-offset < size {
+				size = hole - offset
+			}
+			n, err := src.ReadAt(buffer[:size], offset)
+			if err != nil {
+				return err
+			}
+			if n == 0 {
+				return io.ErrNoProgress
+			}
+			written, err := dst.WriteAt(buffer[:n], offset)
+			if err != nil {
+				return err
+			}
+			if written != n {
+				return io.ErrShortWrite
+			}
+			offset += int64(n)
+		}
+		cursor = hole
+	}
+	var final unix.Stat_t
+	if err := unix.Fstat(int(src.Fd()), &final); err != nil {
+		return err
+	}
+	if final.Dev != source.Dev || final.Ino != source.Ino || final.Size != source.Size || final.Mtim != source.Mtim || final.Ctim != source.Ctim {
+		return fmt.Errorf("application memory changed during sparse copy")
+	}
+	return nil
+}
diff --git a/runsc/boot/application_memory_test.go b/runsc/boot/application_memory_test.go
new file mode 100644
--- /dev/null
+++ b/runsc/boot/application_memory_test.go
@@ -0,0 +1,47 @@
+// Copyright 2026 The gVisor Authors.
+// SPDX-License-Identifier: Apache-2.0
+package boot
+
+import (
+	"bytes"
+	"os"
+	"path/filepath"
+	"testing"
+)
+
+func TestCopySparseApplicationMemory(t *testing.T) {
+	dir := t.TempDir()
+	src, err := os.Create(filepath.Join(dir, "source"))
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer src.Close()
+	dst, err := os.Create(filepath.Join(dir, "target"))
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer dst.Close()
+	if err := src.Truncate(8 << 20); err != nil {
+		t.Fatal(err)
+	}
+	payload := bytes.Repeat([]byte{0xa5}, 4096)
+	for _, offset := range []int64{0, 3 << 20, (8 << 20) - 4096} {
+		if _, err := src.WriteAt(payload, offset); err != nil {
+			t.Fatal(err)
+		}
+	}
+	if err := CopySparseApplicationMemory(dst, src); err != nil {
+		t.Fatal(err)
+	}
+	want, _ := os.ReadFile(src.Name())
+	got, _ := os.ReadFile(dst.Name())
+	if !bytes.Equal(want, got) {
+		t.Fatal("sparse bytes differ")
+	}
+	if err := CopySparseApplicationMemory(dst, src); err == nil {
+		t.Fatal("nonempty target accepted")
+	}
+	if err := CopySparseApplicationMemory(src, src); err == nil {
+		t.Fatal("same source/target accepted")
+	}
+}
