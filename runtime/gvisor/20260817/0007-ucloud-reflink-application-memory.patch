+// CloneApplicationMemory creates a writable COW view of an immutable checkpoint.
+// The destination belongs to the candidate's quota allocation. Reflink support
+// is required: a full copy fallback would silently reintroduce eager restore.
+func CloneApplicationMemory(dst, src *os.File) error {
+	var source, target unix.Stat_t
+	if err := unix.Fstat(int(src.Fd()), &source); err != nil {
+		return err
+	}
+	if err := unix.Fstat(int(dst.Fd()), &target); err != nil {
+		return err
+	}
+	if source.Mode&unix.S_IFMT != unix.S_IFREG || target.Mode&unix.S_IFMT != unix.S_IFREG || target.Size != 0 || source.Dev != target.Dev || (source.Dev == target.Dev && source.Ino == target.Ino) {
+		return fmt.Errorf("application memory clone requires distinct regular files, an empty target, and one filesystem")
+	}
+	if err := unix.IoctlFileClone(int(dst.Fd()), int(src.Fd())); err != nil {
+		return err
+	}
+	var final unix.Stat_t
+	if err := unix.Fstat(int(src.Fd()), &final); err != nil {
+		return err
+	}
+	if final.Dev != source.Dev || final.Ino != source.Ino || final.Size != source.Size || final.Mtim != source.Mtim || final.Ctim != source.Ctim {
+		return fmt.Errorf("application memory changed during reflink clone")
+	}
+	return nil
+}
diff --git a/runsc/boot/application_memory_test.go b/runsc/boot/application_memory_test.go
--- a/runsc/boot/application_memory_test.go
+++ b/runsc/boot/application_memory_test.go
@@ -4,6 +4,7 @@
 
 import (
 	"bytes"
+	"golang.org/x/sys/unix"
 	"os"
 	"path/filepath"
 	"testing"
@@ -45,3 +46,52 @@
 		t.Fatal("same source/target accepted")
 	}
 }
+
+func TestCloneApplicationMemory(t *testing.T) {
+	dir := t.TempDir()
+	src, err := os.Create(filepath.Join(dir, "source"))
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer src.Close()
+	dst, err := os.Create(filepath.Join(dir, "target"))
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer dst.Close()
+	if err := src.Truncate(8 << 20); err != nil {
+		t.Fatal(err)
+	}
+	payload := bytes.Repeat([]byte{0xa5}, 4096)
+	if _, err := src.WriteAt(payload, 3<<20); err != nil {
+		t.Fatal(err)
+	}
+	if err := CloneApplicationMemory(src, src); err == nil {
+		t.Fatal("same file accepted")
+	}
+	if err := CloneApplicationMemory(dst, src); err != nil {
+		if err == unix.EOPNOTSUPP || err == unix.ENOTTY {
+			t.Skip("test filesystem lacks reflink")
+		}
+		t.Fatal(err)
+	}
+	got := make([]byte, len(payload))
+	if _, err := dst.ReadAt(got, 3<<20); err != nil {
+		t.Fatal(err)
+	}
+	if !bytes.Equal(got, payload) {
+		t.Fatal("clone bytes differ")
+	}
+	if _, err := dst.WriteAt([]byte{0x11}, 3<<20); err != nil {
+		t.Fatal(err)
+	}
+	if _, err := src.ReadAt(got, 3<<20); err != nil {
+		t.Fatal(err)
+	}
+	if !bytes.Equal(got, payload) {
+		t.Fatal("clone mutated source")
+	}
+	if err := CloneApplicationMemory(dst, src); err == nil {
+		t.Fatal("nonempty target accepted")
+	}
+}
