# Copy to /etc/ucloud-sandboxes/direct-runtime.env with mode 0600.
UCLOUD_DIRECT_HOST=127.0.0.1
UCLOUD_DIRECT_PORT=8090
UCLOUD_DIRECT_JOB_ID=replace-me
UCLOUD_DIRECT_NODE_ID=replace-me
UCLOUD_DIRECT_RUNSC=/opt/ucloud-direct/bin/runsc-hibernate
UCLOUD_DIRECT_RUNSC_COMMIT=9f653e577965df2ddd13875b5530cd2588661f1c
UCLOUD_DIRECT_INIT_BINARY=/usr/bin/docker-init
UCLOUD_DIRECT_DISK_CAPACITY_MB=460000
UCLOUD_DIRECT_DISK_HEADROOM_MB=16000
UCLOUD_DIRECT_MAX_CONCURRENT_RESTORES=8
UCLOUD_DIRECT_TOTAL_VCPU=32
UCLOUD_DIRECT_TOTAL_MEMORY_MB=98304
UCLOUD_DIRECT_TOTAL_DISK_MB=444000
UCLOUD_DIRECT_CPU_OVERCOMMIT=3
UCLOUD_DIRECT_MEMORY_OVERCOMMIT=2
