{
  "runtimes": {
    "runsc-memfd": {
      "path": "/usr/local/bin/runsc-disk",
      "runtimeArgs": [
        "--app-huge-pages=false"
      ]
    },
    "runsc-xfs": {
      "path": "/usr/local/bin/runsc-disk",
