[Unit]
Description=UCloud direct-runsc sandbox node agent
After=docker.service network-online.target
Requires=docker.service
Wants=network-online.target
Conflicts=ucloud-sandbox-node-agent.service
ConditionPathIsMountPoint=/var/lib/ucloud-direct-data

[Service]
Type=simple
User=root
Group=root
EnvironmentFile=/etc/ucloud-sandboxes/direct-runtime.env
ExecStart=/opt/ucloud-direct/venv/bin/ucloud-sandboxes serve-direct-node-agent \
  --host ${UCLOUD_DIRECT_HOST} \
  --port ${UCLOUD_DIRECT_PORT} \
  --job-id ${UCLOUD_DIRECT_JOB_ID} \
  --node-id ${UCLOUD_DIRECT_NODE_ID} \
  --state-root /var/lib/ucloud-direct/state \
  --image-file /var/lib/ucloud-direct/state/images.json \
  --quota-root /var/lib/ucloud-direct-data/ucloud-hibernation \
  --runsc ${UCLOUD_DIRECT_RUNSC} \
  --runsc-commit ${UCLOUD_DIRECT_RUNSC_COMMIT} \
  --init-binary ${UCLOUD_DIRECT_INIT_BINARY} \
  --disk-capacity-mb ${UCLOUD_DIRECT_DISK_CAPACITY_MB} \
  --disk-headroom-mb ${UCLOUD_DIRECT_DISK_HEADROOM_MB} \
  --max-concurrent-restores ${UCLOUD_DIRECT_MAX_CONCURRENT_RESTORES} \
  --total-vcpu ${UCLOUD_DIRECT_TOTAL_VCPU} \
  --total-memory-mb ${UCLOUD_DIRECT_TOTAL_MEMORY_MB} \
  --total-disk-mb ${UCLOUD_DIRECT_TOTAL_DISK_MB} \
  --cpu-overcommit ${UCLOUD_DIRECT_CPU_OVERCOMMIT} \
  --memory-overcommit ${UCLOUD_DIRECT_MEMORY_OVERCOMMIT} \
  --disk-overcommit 1
Restart=on-failure
RestartSec=2s
KillMode=mixed
TimeoutStopSec=30s
LimitNOFILE=1048576
TasksMax=infinity

[Install]
WantedBy=multi-user.target
