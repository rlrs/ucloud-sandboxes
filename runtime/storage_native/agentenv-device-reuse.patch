+//! Retain recently returned devices across park/resume bursts. The high water
+//! mark is a steady-state cache target, never an active-device admission limit.
+use std::collections::VecDeque;
+use std::sync::Mutex;
+use std::time::{Duration, Instant};
+
+pub(crate) const DEVICE_IDLE_GRACE: Duration = Duration::from_secs(60);
+
+struct Entry<T> {
+    value: T,
+    returned_at: Instant,
+}
+struct State<T> {
+    entries: VecDeque<Entry<T>>,
+    closed: bool,
+}
+pub(crate) struct IdleDevicePool<T> {
+    state: Mutex<State<T>>,
+    low: usize,
+    high: usize,
+}
+impl<T> IdleDevicePool<T> {
+    pub(crate) fn new(low: usize, high: usize) -> Self {
+        Self {
+            state: Mutex::new(State {
+                entries: VecDeque::new(),
+                closed: false,
+            }),
+            low: low.min(high),
+            high,
+        }
+    }
+    pub(crate) fn len(&self) -> usize {
+        self.state.lock().unwrap().entries.len()
+    }
+    pub(crate) fn refill_needed(&self) -> usize {
+        let state = self.state.lock().unwrap();
+        if state.closed {
+            0
+        } else {
+            self.low.saturating_sub(state.entries.len())
+        }
+    }
+    pub(crate) fn acquire(&self, matches: impl Fn(&T) -> bool, allow_resize: bool) -> Option<T> {
+        let mut state = self.state.lock().unwrap();
+        // Prefer the most recently used exact-size device, avoiding UPDATE_SIZE.
+        let index = state
+            .entries
+            .iter()
+            .rposition(|entry| matches(&entry.value))
+            .or_else(|| {
+                allow_resize
+                    .then(|| state.entries.len().checked_sub(1))
+                    .flatten()
+            })?;
+        state.entries.remove(index).map(|entry| entry.value)
+    }
+    pub(crate) fn release(&self, value: T, now: Instant) -> Result<(), T> {
+        let mut state = self.state.lock().unwrap();
+        if state.closed {
+            return Err(value);
+        }
+        state.entries.push_back(Entry {
+            value,
+            returned_at: now,
+        });
+        Ok(())
+    }
+    pub(crate) fn retain_prewarmed(&self, value: T, now: Instant) -> Result<(), T> {
+        let mut state = self.state.lock().unwrap();
+        // Concurrent returns satisfy reserve demand before speculative devices.
+        if state.closed || state.entries.len() >= self.low {
+            return Err(value);
+        }
+        state.entries.push_back(Entry {
+            value,
+            returned_at: now,
+        });
+        Ok(())
+    }
+    pub(crate) fn expired_excess(&self, now: Instant) -> Vec<T> {
+        let mut state = self.state.lock().unwrap();
+        let mut retired = Vec::new();
+        while state.entries.len() > self.high {
+            if state.entries.front().is_none_or(|entry| {
+                now.saturating_duration_since(entry.returned_at) < DEVICE_IDLE_GRACE
+            }) {
+                break;
+            }
+            retired.push(state.entries.pop_front().unwrap().value);
+        }
+        retired
+    }
+    pub(crate) fn drain_all(&self) -> Vec<T> {
+        let mut state = self.state.lock().unwrap();
+        state.closed = true;
+        state.entries.drain(..).map(|entry| entry.value).collect()
+    }
+}
+
+pub(crate) fn refill_retry_delay(failures: u32) -> Duration {
+    Duration::from_secs(1u64 << failures.saturating_sub(1).min(5))
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    #[test]
+    fn repeated_bursts_reuse_all_devices_above_steady_target() {
+        let pool = IdleDevicePool::new(2, 16);
+        let start = Instant::now();
+        for i in 0..64 {
+            pool.release(i, start).unwrap();
+        }
+        for cycle in 0..10 {
+            let now = start + Duration::from_secs(cycle * 5);
+            assert!(pool.expired_excess(now).is_empty());
+            let mut active = (0..64)
+                .map(|_| pool.acquire(|_| true, false).unwrap())
+                .collect::<Vec<_>>();
+            active.sort_unstable();
+            assert_eq!(active, (0..64).collect::<Vec<_>>());
+            for device in active {
+                pool.release(device, now).unwrap();
+            }
+        }
+        assert_eq!(pool.len(), 64);
+    }
+    #[test]
+    fn trims_only_expired_excess_and_keeps_new_returns() {
+        let pool = IdleDevicePool::new(1, 2);
+        let start = Instant::now();
+        for i in 0..4 {
+            pool.release(i, start).unwrap();
+        }
+        pool.release(4, start + DEVICE_IDLE_GRACE).unwrap();
+        assert_eq!(
+            pool.expired_excess(start + DEVICE_IDLE_GRACE),
+            vec![0, 1, 2]
+        );
+        assert_eq!(pool.len(), 2);
+    }
+    #[test]
+    fn exact_size_preferred_over_resize_and_unsupported_resize_refused() {
+        let pool = IdleDevicePool::new(1, 2);
+        let start = Instant::now();
+        pool.release(10, start).unwrap();
+        pool.release(20, start).unwrap();
+        assert_eq!(pool.acquire(|size| *size == 10, true), Some(10));
+        assert_eq!(pool.acquire(|size| *size == 10, false), None);
+        assert_eq!(pool.acquire(|size| *size == 10, true), Some(20));
+    }
+    #[test]
+    fn returned_devices_satisfy_refill_and_shutdown_rejects_late_returns() {
+        let pool = IdleDevicePool::new(2, 16);
+        let start = Instant::now();
+        assert_eq!(pool.refill_needed(), 2);
+        pool.release(1, start).unwrap();
+        pool.release(2, start).unwrap();
+        assert_eq!(pool.retain_prewarmed(3, start), Err(3));
+        assert_eq!(pool.refill_needed(), 0);
+        assert_eq!(pool.drain_all(), vec![1, 2]);
+        assert_eq!(pool.release(4, start), Err(4));
+        assert_eq!(pool.retain_prewarmed(5, start), Err(5));
+        assert_eq!(pool.refill_needed(), 0);
+    }
+    #[test]
+    fn allocation_failure_retry_is_delayed_and_bounded() {
+        assert_eq!(refill_retry_delay(1), Duration::from_secs(1));
+        assert_eq!(refill_retry_delay(2), Duration::from_secs(2));
+        assert_eq!(refill_retry_delay(u32::MAX), Duration::from_secs(32));
+    }
+}
