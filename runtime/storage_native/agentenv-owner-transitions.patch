 // ── Request handlers ────────────────────────────────────────────────────────
 
-fn remove_runtime_owner(
-    runtime_owners: &DashMap<String, RuntimeDeviceOwner>,
-    owner_by_dev_id: &DashMap<u32, String>,
-    dev_id: u32,
