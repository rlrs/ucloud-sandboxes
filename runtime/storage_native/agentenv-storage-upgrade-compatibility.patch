+#[tokio::test]
+async fn test_hybrid_upper_rejects_legacy_or_unknown_format_before_replay() {
+    for (data_sub_version, index_sub_version) in [(1, 2), (2, 1), (3, 2), (2, 3)] {
+        let dir = TempDir::new().unwrap();
+        let (data, index, upper) = create_hybrid_lsmt_env(&dir, 1024 * 1024).await;
+        upper.write_at(0, &[0xAB; 4096]).await.unwrap();
+        upper.discard(0, 4096).await.unwrap();
+        upper.sync().await.unwrap();
+        drop(upper);
+        for (file, sub_version) in [(&data, data_sub_version), (&index, index_sub_version)] {
+            let bytes = file.read_at(0, size_of::<HeaderTrailer>()).await.unwrap();
+            let mut header = HeaderTrailer::read_from_bytes(&bytes).unwrap();
+            header.sub_version = sub_version;
+            file.write_at(0, header.as_bytes()).await.unwrap();
+            file.sync().await.unwrap();
+        }
+        let before = data
+            .read_at(0, data.size().await.unwrap() as usize)
+            .await
+            .unwrap();
+        let error = open_hybrid_lsmt_env(data.clone(), index, None, vec![])
+            .await
+            .err()
+            .expect("legacy/unknown writable format must fail closed");
+        assert!(error
+            .to_string()
+            .contains("unsupported hybrid writable upper format"));
+        assert_eq!(
+            before,
+            data.read_at(0, data.size().await.unwrap() as usize)
+                .await
+                .unwrap()
+        );
+    }
+}
