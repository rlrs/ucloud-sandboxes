+// The pinned UCloud build marks fresh hybrid uppers. Upstream's backed-zero
+// replay is incompatible with pre-v0.2 hybrid discard records; never infer
+// compatibility from an old header whose geometry otherwise looks valid.
+pub(super) const HYBRID_UPPER_SUB_VERSION: u8 = 2;
+
+pub(super) fn validate_hybrid_upper_format(header: &HeaderTrailer) -> Result<()> {
+    ensure!(
+        !header.is_hybrid_rw()
+            || (header.version == 1 && header.sub_version == HYBRID_UPPER_SUB_VERSION),
+        "unsupported hybrid writable upper format; seal/publish with the old backend and restore into a fresh upper"
+    );
+    Ok(())
+}
