+const DENSE_EXPORT_BUFFER_SIZE: usize = 8 * 1024 * 1024;
+
+struct UnixStreamCompactWriter {
+    stream: Mutex<UnixStream>,
+    digest: Mutex<DenseLayerDigest>,
+}
+
+impl UnixStreamCompactWriter {
+    fn new(stream: UnixStream) -> Arc<Self> {
+        Arc::new(Self {
+            stream: Mutex::new(stream),
+            digest: Mutex::new(DenseLayerDigest::default()),
+        })
+    }
+
+    async fn finish(&self) -> Result<dense_export::DenseLayerDescriptor> {
+        self.stream.lock().await.shutdown().await?;
+        Ok(self.digest.lock().await.descriptor())
+    }
+
+    async fn write_bytes(&self, offset: u64, data: &[u8]) -> Result<()> {
+        self.digest.lock().await.absorb(offset, data)?;
+        self.stream.lock().await.write_all(data).await?;
+        Ok(())
+    }
+}
+
+#[async_trait]
+impl CompactWriter for UnixStreamCompactWriter {
+    async fn alloc_buffer(&self) -> Result<Box<dyn CompactBuffer>> {
+        Ok(Box::new(vec![0u8; DENSE_EXPORT_BUFFER_SIZE]))
+    }
+
+    fn buffer_size(&self) -> usize {
+        DENSE_EXPORT_BUFFER_SIZE
+    }
+
+    async fn write(&self, buf: Box<dyn CompactBuffer>, offset: u64, len: usize) -> Result<()> {
+        let data = AsRef::<[u8]>::as_ref(buf.as_ref());
+        if len > data.len() {
+            bail!("dense export write length exceeds buffer");
+        }
+        self.write_bytes(offset, &data[..len]).await
+    }
+
+    async fn write_all_at(&self, data: &[u8], offset: u64) -> Result<()> {
+        self.write_bytes(offset, data).await
+    }
+}
