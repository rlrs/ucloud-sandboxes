+async fn handle_export_dense_layer(
+    source_layer_path: &Path,
+    stream_socket_path: &Path,
+) -> Result<DaemonResponse> {
+    if !source_layer_path.is_absolute() || !stream_socket_path.is_absolute() {
+        bail!("dense export paths must be absolute");
+    }
+    let stream = UnixStream::connect(stream_socket_path)
+        .await
+        .with_context(|| {
+            format!(
+                "connect dense export stream socket {}",
+                stream_socket_path.display()
+            )
+        })?;
+    let writer = UnixStreamCompactWriter::new(stream);
+    dense_export::write_dense_layer_to(source_layer_path, writer.clone())
+        .await
+        .with_context(|| {
+            format!(
+                "dense-export overlaybd layer {}",
+                source_layer_path.display()
+            )
+        })?;
+    let descriptor = writer.finish().await?;
+    Ok(DaemonResponse::DenseLayerExported {
+        digest: descriptor.digest,
+        size: descriptor.size,
+    })
+}
+
+async fn handle_export_compacted_image(
+    image_service_cache: &ImageServiceCache,
+    source_image_config: &Path,
+    global_config: &Path,
+    stream_socket_path: &Path,
+) -> Result<DaemonResponse> {
+    if !source_image_config.is_absolute()
+        || !global_config.is_absolute()
+        || !stream_socket_path.is_absolute()
+    {
+        bail!("compacted image export paths must be absolute");
+    }
+    let stream = UnixStream::connect(stream_socket_path)
+        .await
+        .with_context(|| {
+            format!(
+                "connect compacted image stream socket {}",
+                stream_socket_path.display()
+            )
+        })?;
+    let writer = UnixStreamCompactWriter::new(stream);
+    let image_service = image_service_cache
+        .get_or_create(global_config)
+        .await
+        .context("resolve image service for compacted export")?;
+    let image = image_service
+        .create_image_file(source_image_config)
+        .await
+        .with_context(|| {
+            format!(
+                "open overlaybd image for compacted export {}",
+                source_image_config.display()
+            )
+        })?;
+    let mut args = CommitArgs::from_writer(writer.clone());
+    // Registry streams are content-addressed sequential byte streams.
+    args.concurrency = 1;
+    image
+        .compact_with_args(args)
+        .await
+        .with_context(|| format!("compact overlaybd image {}", source_image_config.display()))?;
+    let descriptor = writer.finish().await?;
+    Ok(DaemonResponse::DenseLayerExported {
+        digest: descriptor.digest,
+        size: descriptor.size,
+    })
+}
