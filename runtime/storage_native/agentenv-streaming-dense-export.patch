+async fn handle_export_dense_layer(
+    source_layer_path: &Path,
+    stream_socket_path: &Path,
+) -> Result<DaemonResponse> {
+    if !source_layer_path.is_absolute() || !stream_socket_path.is_absolute() {
+        bail!("dense export paths must be absolute");
+    }
+    let stream = UnixStream::connect(stream_socket_path)
+        .await
+        .with_context(|| {
+            format!(
+                "connect dense export stream socket {}",
+                stream_socket_path.display()
+            )
+        })?;
+    let writer = UnixStreamCompactWriter::new(stream);
+    dense_export::write_dense_layer_to(source_layer_path, writer.clone())
+        .await
+        .with_context(|| {
+            format!(
+                "dense-export overlaybd layer {}",
+                source_layer_path.display()
+            )
+        })?;
+    let descriptor = writer.finish().await?;
+    Ok(DaemonResponse::DenseLayerExported {
+        digest: descriptor.digest,
+        size: descriptor.size,
+    })
+}
