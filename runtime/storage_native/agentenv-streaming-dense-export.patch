+#[tokio::test]
+async fn test_flatten_mixed_data_and_discard_keeps_index_sorted() {
+    let temp_dir = TempDir::new().unwrap();
+    let vsize = 3 * 4096;
+    let (data, _index, lsmt) = create_lsmt_env(&temp_dir, vsize).await;
+
+    let first = vec![0xA5; 4096];
+    let last = vec![0x5A; 4096];
+    lsmt.write_at(0, &first).await.unwrap();
+    <LSMTFile as VirtualFile>::discard(&lsmt, 4096, 4096)
+        .await
+        .unwrap();
+    lsmt.write_at(8192, &last).await.unwrap();
+    lsmt.close_seal().await.unwrap();
+    drop(lsmt);
+
+    let source = open_file_ro(data).await.unwrap();
+    let ring = test_io_ring();
+    let flat = Arc::new(
+        LocalFile::new(temp_dir.path().join("flat-mixed.lsmt"), ring)
+            .await
+            .unwrap(),
+    );
+    source.flatten(flat.clone()).await.unwrap();
+
+    let flattened = open_file_ro(flat).await.unwrap();
+    let mappings = flattened
+        .index_view
+        .as_ref()
+        .expect("flattened index view")
+        .mappings();
+    assert!(
+        mappings
+            .windows(2)
+            .all(|pair| pair[0].offset() <= pair[1].offset()),
+        "flattened data/discard index must remain sorted"
+    );
+    assert_eq!(
+        flattened.read_at(0, 4096).await.unwrap().as_ref(),
+        first.as_slice()
+    );
+    assert!(flattened
+        .read_at(4096, 4096)
+        .await
+        .unwrap()
+        .iter()
+        .all(|byte| *byte == 0));
+    assert_eq!(
+        flattened.read_at(8192, 4096).await.unwrap().as_ref(),
+        last.as_slice()
+    );
+}
