[Unit]
Description=UCloud Sandbox autoscaler
After=network-online.target ucloud-sandbox-gateway.service
Wants=network-online.target

[Service]
Type=simple
User=ucloud
Group=ucloud
WorkingDirectory=/work/ucloud-sandboxes
Environment=UCLOUD_PROJECT_ID=
Environment=UCLOUD_DEPLOYMENT_ID=
Environment=UCLOUD_STATE_DIR=/work/ucloud-sandboxes/state
Environment=UCLOUD_SESSION_FILE=/work/ucloud-sandboxes/state/ucloud-session.json
Environment=UCLOUD_PRIVATE_NETWORK_ID=
Environment=UCLOUD_AUTOSCALER_INTERVAL_SECONDS=5
Environment=UCLOUD_SANDBOX_PRODUCT_ID=cpu-amd-zen5-32-vcpu
Environment=UCLOUD_SANDBOX_DISK_GB=2000
Environment=UCLOUD_SANDBOX_IDLE_SECONDS=600
Environment=UCLOUD_LIVE_PRESSURE_ENABLED=true
Environment=UCLOUD_LIVE_PRESSURE_WINDOW_SECONDS=60
Environment=UCLOUD_LIVE_PRESSURE_MIN_SAMPLES=3
Environment=UCLOUD_LIVE_PRESSURE_FRESH_SECONDS=30
Environment=UCLOUD_CREATE_PRESSURE_ENABLED=true
Environment=UCLOUD_CREATE_PRESSURE_WINDOW_SECONDS=30
Environment=UCLOUD_CREATE_PRESSURE_MIN_SAMPLES=2
Environment=UCLOUD_CREATE_PRESSURE_FRESH_SECONDS=15
Environment=UCLOUD_CREATE_TARGET_CONCURRENCY_PER_NODE=8
Environment=UCLOUD_CREATE_PRESSURE_MAX_HEADROOM_NODES=1
Environment=UCLOUD_TARGET_CPU_UTILIZATION=0.70
Environment=UCLOUD_TARGET_MEMORY_UTILIZATION=0.80
Environment=UCLOUD_MAX_MEMORY_PSI_FULL_AVG10=5.0
Environment=UCLOUD_TARGET_STORAGE_QUEUE_UTILIZATION=0.75
Environment=UCLOUD_PRESSURE_SCALE_DOWN_COOLDOWN_SECONDS=300
Environment=UCLOUD_PROVISIONING_LATENCY_LOOKBACK_SECONDS=604800
Environment=UCLOUD_PROVISIONING_SCALE_DOWN_MULTIPLIER=2.0
Environment=UCLOUD_PROGRAM_AWARE_AUTOSCALING_ENABLED=false
Environment=UCLOUD_MODEL_WAIT_CAPACITY_WEIGHT=0.10
Environment=UCLOUD_MODEL_WAIT_MAX_HEADROOM_NODES=1
Environment=UCLOUD_BUILDER_PRODUCT_ID=cpu-amd-zen5-16-vcpu
Environment=UCLOUD_BUILDER_DISK_GB=250
Environment=UCLOUD_BUILDER_IDLE_SECONDS=900
Environment=UCLOUD_MAX_BUILDER_NODES=1
Environment=UCLOUD_MAX_INIT_PER_CYCLE=4
Environment=UCLOUD_INIT_RETRY_SECONDS=30
Environment=UCLOUD_INIT_TIMEOUT_SECONDS=1800
Environment=UCLOUD_INIT_HEARTBEAT_URL=
Environment=UCLOUD_INIT_HEARTBEAT_TOKEN_FILE=/work/ucloud-sandboxes/state/heartbeat-token
Environment=UCLOUD_INIT_HEARTBEAT_TOKEN_SOURCE_FILE=/work/ucloud-sandboxes/state/heartbeat-token
Environment=UCLOUD_NODE_CONTROL_TOKEN_FILE=/work/ucloud-sandboxes/state/node-control-token
Environment=UCLOUD_INIT_NODE_CONTROL_TOKEN_FILE=/work/ucloud-sandboxes/state/node-control-token
Environment=UCLOUD_INIT_NODE_CONTROL_TOKEN_SOURCE_FILE=/work/ucloud-sandboxes/state/node-control-token
Environment=UCLOUD_GATEWAY_TOKEN_FILE=/work/ucloud-sandboxes/state/gateway-token
Environment=UCLOUD_MAX_STORAGE_NATIVE_MIGRATIONS_PER_CYCLE=2
Environment=UCLOUD_INIT_AUTHORIZED_KEY_FILE=/work/ucloud-sandboxes/state/ssh/gateway-init.pub
Environment=UCLOUD_INIT_SSH_PRIVATE_KEY_FILE=/work/ucloud-sandboxes/state/ssh/gateway-init
Environment=UCLOUD_INIT_PACKAGE_SPEC=ucloud-sandboxes
Environment=UCLOUD_INIT_BUILDER_PACKAGE_SPEC=
Environment=UCLOUD_DOCKER_INSECURE_REGISTRY=ucloud-sandbox-registry:5000
Environment=UCLOUD_DOCKER_HOST_ALIAS=
Environment=UCLOUD_INIT_DOCKER_QUOTA_IMAGE_GB=440
Environment=UCLOUD_INIT_BUILDER_DOCKER_QUOTA_IMAGE_GB=200
Environment=UCLOUD_INIT_SWAP_GB=96
Environment=UCLOUD_INIT_CPU_OVERCOMMIT=1
Environment=UCLOUD_INIT_MEMORY_OVERCOMMIT=1
Environment=UCLOUD_INIT_DISK_OVERCOMMIT=1.0
Environment=UCLOUD_INIT_DIRECT_RUNSC_COMMIT=0000000000000000000000000000000000000000
Environment=UCLOUD_INIT_DIRECT_NETWORK=sandbox
Environment=UCLOUD_INIT_DIRECT_NETWORK_ALLOW_TCP=
Environment=UCLOUD_INIT_DIRECT_DISK_HEADROOM_MB=16384
Environment=UCLOUD_INIT_DIRECT_MAX_CONCURRENT_RESTORES=8
Environment=UCLOUD_INIT_MAX_CONCURRENT_IMAGE_PULLS=8
Environment=UCLOUD_INIT_STORAGE_NATIVE_REGISTRY_URL=
Environment=UCLOUD_INIT_STORAGE_NATIVE_REPOSITORY=ucloud-sandbox-snapshots
Environment=UCLOUD_INIT_STORAGE_NATIVE_CACHE_GB=32
EnvironmentFile=/etc/ucloud-sandboxes/autoscaler.env
ExecStartPre=/bin/sh -c 'test -n "$UCLOUD_PROJECT_ID" && test -n "$UCLOUD_DEPLOYMENT_ID" && test -n "$UCLOUD_PRIVATE_NETWORK_ID" && test -n "$UCLOUD_INIT_HEARTBEAT_URL"'
ExecStart=/work/ucloud-sandboxes/gateway-venv/bin/ucloud-sandboxes autoscaler-loop --project ${UCLOUD_PROJECT_ID} --deployment-id ${UCLOUD_DEPLOYMENT_ID} --state-dir ${UCLOUD_STATE_DIR} --session-file ${UCLOUD_SESSION_FILE} --interval-seconds ${UCLOUD_AUTOSCALER_INTERVAL_SECONDS} --route-file ${UCLOUD_STATE_DIR}/routes.sqlite --metrics-file ${UCLOUD_STATE_DIR}/metrics.sqlite --heartbeats ${UCLOUD_STATE_DIR}/heartbeats.json --private-network-id ${UCLOUD_PRIVATE_NETWORK_ID} --product-id ${UCLOUD_SANDBOX_PRODUCT_ID} --disk-gb ${UCLOUD_SANDBOX_DISK_GB} --scale-down-idle-seconds ${UCLOUD_SANDBOX_IDLE_SECONDS} --live-pressure-enabled ${UCLOUD_LIVE_PRESSURE_ENABLED} --live-pressure-window-seconds ${UCLOUD_LIVE_PRESSURE_WINDOW_SECONDS} --live-pressure-min-samples ${UCLOUD_LIVE_PRESSURE_MIN_SAMPLES} --live-pressure-fresh-seconds ${UCLOUD_LIVE_PRESSURE_FRESH_SECONDS} --create-pressure-enabled ${UCLOUD_CREATE_PRESSURE_ENABLED} --create-pressure-window-seconds ${UCLOUD_CREATE_PRESSURE_WINDOW_SECONDS} --create-pressure-min-samples ${UCLOUD_CREATE_PRESSURE_MIN_SAMPLES} --create-pressure-fresh-seconds ${UCLOUD_CREATE_PRESSURE_FRESH_SECONDS} --create-target-concurrency-per-node ${UCLOUD_CREATE_TARGET_CONCURRENCY_PER_NODE} --create-pressure-max-headroom-nodes ${UCLOUD_CREATE_PRESSURE_MAX_HEADROOM_NODES} --target-cpu-utilization ${UCLOUD_TARGET_CPU_UTILIZATION} --target-memory-utilization ${UCLOUD_TARGET_MEMORY_UTILIZATION} --max-memory-psi-full-avg10 ${UCLOUD_MAX_MEMORY_PSI_FULL_AVG10} --target-storage-queue-utilization ${UCLOUD_TARGET_STORAGE_QUEUE_UTILIZATION} --pressure-scale-down-cooldown-seconds ${UCLOUD_PRESSURE_SCALE_DOWN_COOLDOWN_SECONDS} --provisioning-latency-lookback-seconds ${UCLOUD_PROVISIONING_LATENCY_LOOKBACK_SECONDS} --provisioning-scale-down-multiplier ${UCLOUD_PROVISIONING_SCALE_DOWN_MULTIPLIER} --program-aware-autoscaling-enabled ${UCLOUD_PROGRAM_AWARE_AUTOSCALING_ENABLED} --model-wait-capacity-weight ${UCLOUD_MODEL_WAIT_CAPACITY_WEIGHT} --model-wait-max-headroom-nodes ${UCLOUD_MODEL_WAIT_MAX_HEADROOM_NODES} --builder-product-id ${UCLOUD_BUILDER_PRODUCT_ID} --builder-disk-gb ${UCLOUD_BUILDER_DISK_GB} --builder-scale-down-idle-seconds ${UCLOUD_BUILDER_IDLE_SECONDS} --max-builder-nodes ${UCLOUD_MAX_BUILDER_NODES} --max-storage-native-migrations-per-cycle ${UCLOUD_MAX_STORAGE_NATIVE_MIGRATIONS_PER_CYCLE} --execute --execute-stops --execute-init --node-control-bearer-token-file ${UCLOUD_NODE_CONTROL_TOKEN_FILE} --gateway-control-bearer-token-file ${UCLOUD_GATEWAY_TOKEN_FILE} --init-state-file ${UCLOUD_STATE_DIR}/vm-bootstrap.json --max-init-per-cycle ${UCLOUD_MAX_INIT_PER_CYCLE} --init-retry-seconds ${UCLOUD_INIT_RETRY_SECONDS} --init-timeout-seconds ${UCLOUD_INIT_TIMEOUT_SECONDS} --init-heartbeat-url ${UCLOUD_INIT_HEARTBEAT_URL} --init-heartbeat-bearer-token-file ${UCLOUD_INIT_HEARTBEAT_TOKEN_FILE} --init-heartbeat-bearer-token-source-file ${UCLOUD_INIT_HEARTBEAT_TOKEN_SOURCE_FILE} --init-node-control-bearer-token-file ${UCLOUD_INIT_NODE_CONTROL_TOKEN_FILE} --init-node-control-bearer-token-source-file ${UCLOUD_INIT_NODE_CONTROL_TOKEN_SOURCE_FILE} --init-authorized-key-file ${UCLOUD_INIT_AUTHORIZED_KEY_FILE} --init-package-spec ${UCLOUD_INIT_PACKAGE_SPEC} --init-builder-package-spec ${UCLOUD_INIT_BUILDER_PACKAGE_SPEC} --init-node-agent-host 0.0.0.0 --init-docker-quota-image-gb ${UCLOUD_INIT_DOCKER_QUOTA_IMAGE_GB} --init-builder-docker-quota-image-gb ${UCLOUD_INIT_BUILDER_DOCKER_QUOTA_IMAGE_GB} --init-swap-gb ${UCLOUD_INIT_SWAP_GB} --init-docker-insecure-registry ${UCLOUD_DOCKER_INSECURE_REGISTRY} --init-host-alias=${UCLOUD_DOCKER_HOST_ALIAS} --init-buildx-direct-push --init-cpu-overcommit ${UCLOUD_INIT_CPU_OVERCOMMIT} --init-memory-overcommit ${UCLOUD_INIT_MEMORY_OVERCOMMIT} --init-disk-overcommit ${UCLOUD_INIT_DISK_OVERCOMMIT} --init-direct-runsc-commit ${UCLOUD_INIT_DIRECT_RUNSC_COMMIT} --init-direct-network ${UCLOUD_INIT_DIRECT_NETWORK} --init-direct-network-allow-tcp ${UCLOUD_INIT_DIRECT_NETWORK_ALLOW_TCP} --init-direct-disk-headroom-mb ${UCLOUD_INIT_DIRECT_DISK_HEADROOM_MB} --init-direct-max-concurrent-restores ${UCLOUD_INIT_DIRECT_MAX_CONCURRENT_RESTORES} --init-max-concurrent-image-pulls ${UCLOUD_INIT_MAX_CONCURRENT_IMAGE_PULLS} --init-storage-native-registry-url ${UCLOUD_INIT_STORAGE_NATIVE_REGISTRY_URL} --init-storage-native-repository ${UCLOUD_INIT_STORAGE_NATIVE_REPOSITORY} --init-storage-native-cache-gb ${UCLOUD_INIT_STORAGE_NATIVE_CACHE_GB} --init-ssh-private-key-file ${UCLOUD_INIT_SSH_PRIVATE_KEY_FILE}
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
