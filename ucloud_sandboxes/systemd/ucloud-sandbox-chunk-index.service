[Unit]
Description=UCloud chunk store index (immutable_environments.chunk_store)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=ucloud
Group=ucloud
StateDirectory=ucloud-chunk-index
StateDirectoryMode=0700
# HETZNER_S3_* (or the names chunk_store configures); only this service and
# builders hold the key, workers get presigned URLs.
EnvironmentFile=-/etc/ucloud-sandboxes/chunk-store.env
ExecStart=/work/ucloud-sandboxes/gateway-venv/bin/ucloud-sandboxes serve-chunk-index --config /etc/ucloud-sandboxes/deployment.json
Restart=always
RestartSec=2
# Exit 78: chunk_store is not configured; stay stopped until it is.
SuccessExitStatus=78
RestartPreventExitStatus=78
LimitNOFILE=65536

[Install]
WantedBy=multi-user.target
