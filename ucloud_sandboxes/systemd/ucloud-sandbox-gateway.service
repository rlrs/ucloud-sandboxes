[Unit]
Description=UCloud Sandbox gateway/control plane
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=ucloud
Group=ucloud
WorkingDirectory=/work/ucloud-sandboxes
ExecStart=/work/ucloud-sandboxes/gateway-venv/bin/ucloud-sandboxes serve-control-plane --config /etc/ucloud-sandboxes/deployment.json
Restart=always
RestartSec=2

[Install]
WantedBy=multi-user.target
