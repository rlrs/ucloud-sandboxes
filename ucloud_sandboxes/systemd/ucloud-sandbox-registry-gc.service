[Unit]
Description=Garbage collect UCloud sandbox private registry
Requires=docker.service
After=docker.service
Conflicts=ucloud-sandbox-registry-prune.service

[Service]
Type=oneshot
ExecStart=/work/ucloud-sandboxes/gateway-venv/bin/python -m ucloud_sandboxes.systemd registry-gc --config /etc/ucloud-sandboxes/deployment.json
