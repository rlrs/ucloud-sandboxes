[Unit]
Description=Sweep unreferenced UCloud sandbox private registry blobs
Requires=docker.service
After=docker.service ucloud-sandbox-registry.service

[Service]
Type=oneshot
EnvironmentFile=-/etc/ucloud-sandboxes/registry-store.env
# Physical collection stops the registry and holds its exclusive writer fence.
ExecStart=/work/ucloud-sandboxes/gateway-venv/bin/python -m ucloud_sandboxes.systemd registry-gc --config /etc/ucloud-sandboxes/deployment.json
ExecStopPost=-/work/ucloud-sandboxes/gateway-venv/bin/python -m ucloud_sandboxes.systemd registry-recover
