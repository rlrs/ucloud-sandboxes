[Unit]
Description=Prune UCloud sandbox private registry tags by age and reference
Wants=ucloud-sandbox-registry.service
After=ucloud-sandbox-registry.service

[Service]
Type=oneshot
# Wait for a running sweep or pressure cleanup instead of failing the run.
# Open the root-owned maintenance lock before switching to the routing database's
# service identity: PostgreSQL peer authentication requires the ucloud OS user.
ExecStart=/usr/bin/flock --exclusive --wait 1800 /run/lock/ucloud-sandbox-registry-maintenance.lock /usr/sbin/runuser -u ucloud -- /work/ucloud-sandboxes/gateway-venv/bin/ucloud-sandboxes registry-prune --config /etc/ucloud-sandboxes/deployment.json --execute
