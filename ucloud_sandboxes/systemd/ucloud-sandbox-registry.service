[Unit]
Description=UCloud sandbox private Docker registry
After=network-online.target docker.service
Wants=network-online.target
Requires=docker.service

[Service]
Type=simple
EnvironmentFile=-/etc/ucloud-sandboxes/registry-store.env
ExecStartPre=-/usr/bin/docker rm -f ucloud-sandbox-registry
ExecStart=/work/ucloud-sandboxes/gateway-venv/bin/python -m ucloud_sandboxes.systemd registry --config /etc/ucloud-sandboxes/deployment.json
ExecStop=/usr/bin/docker stop ucloud-sandbox-registry
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
